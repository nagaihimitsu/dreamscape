{
  "schemaVersion": 1,
  "questions": {
    "smp_mihon_clock_tower_q1": {
      "source": {
        "questionEn": "The clock broke long ago. What did the town do?",
        "options": [
          {
            "id": "A",
            "textEn": "They built a new tower."
          },
          {
            "id": "B",
            "textEn": "They moved the clock to the market."
          },
          {
            "id": "C",
            "textEn": "They kept it at three."
          }
        ],
        "correctOptionId": "C"
      },
      "questionJa": "時計はずっと前に壊れた。街はどうした？",
      "optionsJa": {
        "A": "新しい塔を建てた。",
        "B": "時計を市場へ移した。",
        "C": "三時のままにしておいた。"
      }
    },
    "smp_mihon_clock_tower_q2": {
      "source": {
        "questionEn": "In this town, what does \"Meet me at three\" mean?",
        "options": [
          {
            "id": "A",
            "textEn": "Come exactly at three o'clock."
          },
          {
            "id": "B",
            "textEn": "Come when you are free."
          },
          {
            "id": "C",
            "textEn": "Do not come today."
          }
        ],
        "correctOptionId": "B"
      },
      "questionJa": "この街で「三時に会おう」はどういう意味？",
      "optionsJa": {
        "A": "ちょうど三時に来て。",
        "B": "来られるときに来て。",
        "C": "今日は来ないで。"
      }
    },
    "smp_mihon_clock_tower_q3": {
      "source": {
        "questionEn": "The keeper still rings the bell by hand. When?",
        "options": [
          {
            "id": "A",
            "textEn": "When someone comes back to the town."
          },
          {
            "id": "B",
            "textEn": "Every hour."
          },
          {
            "id": "C",
            "textEn": "Only at night."
          }
        ],
        "correctOptionId": "A"
      },
      "questionJa": "時計番は今も手で鐘を鳴らす。いつ？",
      "optionsJa": {
        "A": "誰かが街に戻ってきたとき。",
        "B": "一時間ごと。",
        "C": "夜だけ。"
      }
    },
