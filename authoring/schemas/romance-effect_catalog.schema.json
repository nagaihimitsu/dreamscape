{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: デートの効果（romance/effect_catalog.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "effects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "affectionDelta": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "trustDelta": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sparkDelta": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "responseProfileId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "memoryId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "accepted",
              "deferred",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "affectionDelta"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
