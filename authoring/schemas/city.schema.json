{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 都市（cities/<都市ID>.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nextCityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "countryCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "nameJa": {
      "type": "string",
      "minLength": 1
    },
    "themeJa": {
      "type": "string",
      "minLength": 1
    },
    "arrivalStoryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\/[a-z][a-z0-9_]*)+(?:\\.[a-z][a-z0-9_]*){0,2}$"
    },
    "firstClearReward": {
      "type": "object",
      "properties": {
        "rewardSourceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rewardSourceId",
        "ap"
      ],
      "additionalProperties": false
    },
    "landmarkIdsPlanned": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "productionStatus": {
      "type": "string",
      "enum": [
        "prototype",
        "complete"
      ]
    },
    "backdropAssetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "backdropImagePath": {
      "type": "string",
      "pattern": "^assets\\/(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*\\/)*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*\\.(?:webp|png|jpe?g)$"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "countryCode",
    "nameJa",
    "themeJa",
    "firstClearReward",
    "landmarkIdsPlanned",
    "productionStatus"
  ]
}
