{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: お店と服（shop/catalog.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "shops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "descriptionJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "heroineLineJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "outfitIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "cityId",
          "nameJa",
          "descriptionJa",
          "outfitIds"
        ],
        "additionalProperties": false
      }
    },
    "outfits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "costume": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "descriptionJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "price": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "boughtLineJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "termIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "id",
          "costume",
          "nameJa",
          "descriptionJa",
          "price",
          "boughtLineJa"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
