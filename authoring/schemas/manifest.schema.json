{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 旅行編の登録（manifest.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nameJa": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "preparing"
      ]
    },
    "cities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "nameJa"
        ],
        "additionalProperties": false
      }
    },
    "currency": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "symbol": {
          "type": "string",
          "pattern": "^\\S+ ?$"
        },
        "unitJa": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "const": "whole"
        }
      },
      "required": [
        "code",
        "symbol",
        "unitJa",
        "unit"
      ],
      "additionalProperties": false
    },
    "initialBudget": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "startWeekday": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "initialState": {
      "type": "object",
      "properties": {
        "ap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingAp": {
          "type": "number",
          "const": 0
        },
        "affection": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "trust": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "spark": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "romanceStage": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            }
          ]
        },
        "confessionStatus": {
          "type": "string",
          "const": "none"
        }
      },
      "required": [
        "ap",
        "pendingAp",
        "affection",
        "trust",
        "spark",
        "romanceStage",
        "confessionStatus"
      ],
      "additionalProperties": false
    },
    "cityPlan": {
      "type": "object",
      "properties": {
        "cityClearAp": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lodgingCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mainTourismCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cityClearAp",
        "lodgingCost",
        "mainTourismCount",
        "dateCount"
      ],
      "additionalProperties": false
    },
    "cityTransition": {
      "type": "string",
      "enum": [
        "manual",
        "after_epilogue"
      ]
    },
    "farePartySize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "intercityModes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "train",
          "car"
        ]
      }
    },
    "transportModes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "movingJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rail",
              "tram",
              "bus",
              "car",
              "three_wheeler",
              "bicycle"
            ]
          },
          "rental": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "nameJa",
          "movingJa",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "titleArt": {
      "type": "object",
      "properties": {
        "imagePath": {
          "type": "string",
          "pattern": "^assets\\/(?!.*\\.\\.)[a-zA-Z0-9_./-]+\\.(?:webp|png|jpe?g)$"
        },
        "captionJa": {
          "type": "string",
          "minLength": 1
        },
        "imagePosition": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "imagePath",
        "captionJa"
      ],
      "additionalProperties": false
    },
    "authoring": {
      "type": "object",
      "properties": {
        "eventPrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "observationFile": {
          "type": "string",
          "minLength": 1
        },
        "imageDirectory": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "eventPrefix",
        "observationFile",
        "imageDirectory"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "order",
    "id",
    "nameJa",
    "status",
    "cities",
    "currency",
    "intercityModes",
    "transportModes"
  ]
}
