{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 特殊戦の導入（presentation/reasoning-intros.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "battleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "storyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\/[a-z][a-z0-9_]*)+$"
          }
        },
        "required": [
          "battleId",
          "storyId"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
