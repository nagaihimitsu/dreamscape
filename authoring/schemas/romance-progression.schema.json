{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 恋愛の段階（romance/progression.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "stages": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "minAffection": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minTrust": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "minSpark": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "minCompletedDates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "playerSuffix": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "minAffection",
          "minTrust",
          "minSpark",
          "minCompletedDates",
          "playerSuffix"
        ],
        "additionalProperties": false
      }
    },
    "confession": {
      "type": "object",
      "properties": {
        "minAffection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minTrust": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minSpark": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minCompletedDates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "minAffection",
        "minTrust",
        "minSpark",
        "minCompletedDates"
      ],
      "additionalProperties": false
    },
    "memoryCallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "memoryId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "textJa": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "memoryId",
          "textJa"
        ],
        "additionalProperties": false
      }
    },
    "fallbackMemoryCallbackJa": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
