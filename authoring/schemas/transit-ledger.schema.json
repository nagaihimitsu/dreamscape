{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 交通判断台帳（travel/<都市ID>-transit.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "cityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sourceRefs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "claimType": {
            "type": "string",
            "enum": [
              "documented_fact",
              "interpretation",
              "hypothesis",
              "legend"
            ]
          },
          "claimJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          }
        },
        "required": [
          "publisher",
          "title",
          "url",
          "checkedAt",
          "claimType",
          "claimJa"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromPlaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "toPlaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "not_suitable",
              "not_applicable",
              "inconclusive"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "reasonJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "sourceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "fromPlaceId",
          "toPlaceId",
          "mode",
          "status",
          "checkedAt",
          "reasonJa",
          "sourceRefs"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cityId",
    "sourceRefs",
    "decisions"
  ]
}
