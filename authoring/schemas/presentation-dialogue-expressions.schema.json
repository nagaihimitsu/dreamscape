{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 台詞の表情（presentation/dialogue-expressions.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "storyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\/[a-z][a-z0-9_]*)+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "enum": [
              "heroine",
              "narrator"
            ]
          },
          "emotion": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "storyId",
          "text",
          "speaker",
          "emotion"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
