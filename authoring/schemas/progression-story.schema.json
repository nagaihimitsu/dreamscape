{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 物語の状態（フラグ・人物・名前つきの条件）（progression/story.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "flags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "noteJa": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "cityId",
          "nameJa"
        ],
        "additionalProperties": false
      }
    },
    "conditions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {}
    }
  },
  "additionalProperties": false
}
