{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 言葉の特性（romance/response_profiles.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "profiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "baseChance": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minChance": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "maxChance": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "relationshipWeights": {
            "type": "object",
            "properties": {
              "affection": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "trust": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "spark": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "affection",
              "trust",
              "spark"
            ],
            "additionalProperties": false
          },
          "chancePerRelationshipPoint": {
            "type": "number",
            "minimum": 0
          },
          "positive": {
            "type": "object",
            "properties": {
              "affection": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "trust": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "spark": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "affection",
              "trust",
              "spark"
            ],
            "additionalProperties": false
          },
          "negative": {
            "type": "object",
            "properties": {
              "affection": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "trust": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "spark": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "affection",
              "trust",
              "spark"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "baseChance",
          "minChance",
          "maxChance",
          "relationshipWeights",
          "chancePerRelationshipPoint",
          "positive",
          "negative"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
