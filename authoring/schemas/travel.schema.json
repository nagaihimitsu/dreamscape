{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 都市の地点・経路・出来事（travel/<都市ID>.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "cityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "places": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "nameJa": {
            "type": "string",
            "minLength": 1
          },
          "nameEn": {
            "type": "string",
            "minLength": 1
          },
          "descriptionJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "backgroundId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "landmarkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "destinationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "openingWindows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "closedWeekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "access": {
            "type": "string",
            "const": "tour"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "claimType": {
                  "type": "string",
                  "enum": [
                    "documented_fact",
                    "interpretation",
                    "hypothesis",
                    "legend"
                  ]
                },
                "claimJa": {
                  "type": "string",
                  "minLength": 1,
                  "language": "ja"
                }
              },
              "required": [
                "publisher",
                "title",
                "url",
                "checkedAt",
                "claimType",
                "claimJa"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "cityId",
          "nameJa",
          "nameEn",
          "latitude",
          "longitude",
          "backgroundId",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromPlaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "toPlaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transferNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "estimation": {
            "type": "string",
            "const": "game_model"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "claimType": {
                  "type": "string",
                  "enum": [
                    "documented_fact",
                    "interpretation",
                    "hypothesis",
                    "legend"
                  ]
                },
                "claimJa": {
                  "type": "string",
                  "minLength": 1,
                  "language": "ja"
                }
              },
              "required": [
                "publisher",
                "title",
                "url",
                "checkedAt",
                "claimType",
                "claimJa"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "fromPlaceId",
          "toPlaceId",
          "mode",
          "minutes",
          "cost",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "placeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "main",
              "date"
            ]
          },
          "titleJa": {
            "type": "string",
            "minLength": 1
          },
          "contentStatus": {
            "type": "string",
            "const": "pending_content"
          },
          "activityMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "apCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "admissionCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startWindows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "endWindows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "cityId",
          "placeId",
          "category",
          "titleJa",
          "activityMinutes",
          "apCost"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "cityId",
    "places",
    "routes",
    "events"
  ]
}
