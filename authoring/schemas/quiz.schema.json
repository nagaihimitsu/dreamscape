{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: クイズ（quizzes/**/*.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "landmarkId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "string",
      "const": "city_finale"
    },
    "cityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "englishLevel": {
      "type": "string",
      "enum": [
        "A2",
        "B1",
        "B2"
      ]
    },
    "questions": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "questionEn": {
            "type": "string",
            "minLength": 1,
            "language": "en"
          },
          "options": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "textEn": {
                  "type": "string",
                  "minLength": 1,
                  "language": "en"
                }
              },
              "required": [
                "id",
                "textEn"
              ],
              "additionalProperties": false
            }
          },
          "correctOptionId": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "vocabularyJa": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "language": "ja"
                }
              },
              "required": [
                "word",
                "meaning"
              ],
              "additionalProperties": false
            }
          },
          "hintJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "correctExplanationJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "incorrectExplanationJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "claimType": {
                  "type": "string",
                  "enum": [
                    "documented_fact",
                    "interpretation",
                    "legend"
                  ]
                },
                "claimJa": {
                  "type": "string",
                  "minLength": 1,
                  "language": "ja"
                }
              },
              "required": [
                "publisher",
                "title",
                "url",
                "checkedAt",
                "claimType",
                "claimJa"
              ],
              "additionalProperties": false
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "hintHeroineJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          },
          "heroineCorrectJa": {
            "type": "string",
            "minLength": 1,
            "language": "ja"
          }
        },
        "required": [
          "id",
          "questionEn",
          "options",
          "correctOptionId",
          "vocabularyJa",
          "hintJa",
          "correctExplanationJa",
          "incorrectExplanationJa",
          "sources",
          "difficulty"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "landmarkId",
    "englishLevel",
    "questions"
  ]
}
