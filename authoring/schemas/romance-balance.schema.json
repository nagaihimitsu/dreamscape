{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 恋愛の釣り合い（romance/balance.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "apCap": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "defaultPlayerName": {
      "type": "string",
      "minLength": 1
    },
    "defaultHeroineName": {
      "type": "string",
      "minLength": 1
    },
    "maxNameLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false
}
