{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dreamscape: 都市の旅行設定（travel/<都市ID>-settings.json）",
  "$comment": "npm run schemas:build が zod のスキーマから作ります。手で直さないでください。入力の補助だけで、検査は npm run content:build です。",
  "type": "object",
  "properties": {
    "initialBudget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hotelPlaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "lodgingCost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retryMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "storyBackgroundId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rentals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "placeIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "claimType": {
                  "type": "string",
                  "enum": [
                    "documented_fact",
                    "interpretation",
                    "hypothesis",
                    "legend"
                  ]
                },
                "claimJa": {
                  "type": "string",
                  "minLength": 1,
                  "language": "ja"
                }
              },
              "required": [
                "publisher",
                "title",
                "url",
                "checkedAt",
                "claimType",
                "claimJa"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "modeId",
          "placeIds",
          "cost",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "initialBudget",
    "hotelPlaceId",
    "lodgingCost",
    "retryMinutes",
    "notes"
  ]
}
