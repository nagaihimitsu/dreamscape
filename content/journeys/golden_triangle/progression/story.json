  "flags": [
    {
      "id": "gt_agra_rain_on_lawn",
      "noteJa": "アクバル廟で、猿が落とした雨の匂いの小瓶を受け止め損ね（ミニゲーム「猿の落とし物」の fumbled・missed）、小瓶が割れてブラックバックのいる芝生にこぼれた"
    },
    {
      "id": "gt_agra_said_for_now",
      "noteJa": "ラーム・バーグの茶屋で「新婚じゃありません。……今のところは」と答えた"
    },
    {
      "id": "gt_agra_sat_between",
      "noteJa": "グル・カ・タールで、父と息子の間の一人分の隙間に座った"
    },
    {
      "id": "gt_agra_tour_she_answered",
      "noteJa": "同じ車の中で、ヴィノードに「それは、彼女が自分で答えられます」と答え、ヒロインが自分の言葉で答えた（母への土産話）"
    },
    {
      "id": "gt_agra_tour_told_reader",
      "noteJa": "同じ車の中で、ヴィノードに「何でも読む人だ、と。看板も、トラックも、壁も」と答えた（母への土産話）"
    },
    {
      "id": "gt_agra_tour_told_traveling",
      "noteJa": "ファテープル・シークリーへ行く車の中で、運転手のヴィノードに「一緒に旅をしている二人だ、とだけ伝えてください」と答えた（母への土産話）"
    },
    {
      "id": "gt_delhi_back_word_secret",
      "noteJa": "ロータス寺院で、背中に書かれた五文字を「読めなかった」と答えた（告白の前に彼女が明かす）"
    },
    {
      "id": "gt_delhi_baoli_player_pigeon",
      "noteJa": "アグラセン・キ・バオリの撮り直しで、主人公が鳩の役をした"
    },
    {
