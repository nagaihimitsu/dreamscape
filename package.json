{
  "name": "dreamscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "npm run content:build",
    "india:draft": "tsx scripts/journeys/golden_triangle/prepare-india-draft.ts --write",
    "india:check": "tsx scripts/journeys/golden_triangle/prepare-india-draft.ts --check && tsx scripts/journeys/golden_triangle/check-india-followup.ts && tsx scripts/journeys/golden_triangle/prepare-india-observations.ts --check && tsx scripts/journeys/golden_triangle/inspect-india-transit.ts",
    "india:transit": "tsx scripts/journeys/golden_triangle/inspect-india-transit.ts",
    "india:readiness": "npm run journey:readiness -- --journey golden_triangle",
    "india:scaffold": "npm run journey:scaffold -- --journey golden_triangle",
    "india:release": "npm run journey:release -- --journey golden_triangle",
    "city:bundle": "tsx scripts/city-bundle-cli.ts",
    "icons:build": "tsx scripts/generate-icons.ts",
    "predev": "npm run content:build",
    "dev": "vite --host 0.0.0.0",
    "dev:sample": "tsx scripts/build-content.ts --with-sample && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run content:build && npm run typecheck && vite build && npm run dist:check",
    "dist:check": "tsx scripts/check-dist.ts",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run content:build -- --with-sample",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "pretest:quick": "npm run content:build -- --with-sample",
    "test:quick": "vitest run --project quick --reporter=dot --silent=passed-only",
    "test:saves": "npm run content:build && vitest run src/persistence",
    "verify": "npm run content:build -- --no-cache --with-sample && npm run test --ignore-scripts && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:e2e:sample": "playwright test -c playwright.sample.config.ts",
    "screens": "tsx scripts/dev/screens.ts",
    "content:inspect": "tsx scripts/inspect-content.ts",
    "journey:new": "tsx scripts/journey-new-cli.ts",
    "journey:scaffold": "tsx scripts/inspect-journey-scaffold.ts",
    "journey:readiness": "tsx scripts/inspect-journey-readiness.ts",
    "journey:release": "tsx scripts/release-journey.ts",
    "journey:transit": "tsx scripts/inspect-journey-transit.ts",
    "journey:scenario": "tsx scripts/check-journey-scenario.ts"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
