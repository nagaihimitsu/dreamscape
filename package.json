{
  "name": "dreamscape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "npm run content:build",
    "predev": "npm run content:build",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run content:build && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run content:build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
